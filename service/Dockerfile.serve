# ITCS355 Lab 3 — serving image
#
# Base image pinned BY DIGEST, the same bytes the training image uses (Lab 1, Task 2).
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /build
COPY requirements-serve.txt ./
RUN pip install --require-hashes --prefix=/install -r requirements-serve.txt

FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS runtime
RUN useradd --create-home --uid 10001 runner
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY --from=builder /install /usr/local
WORKDIR /app
COPY --chown=runner:runner service/ ./service/
COPY --chown=runner:runner src/ ./src/
COPY --chown=runner:runner cloudlayer/ ./cloudlayer/
USER runner

EXPOSE 8080
# The provider's expected paths are absorbed in cloudlayer/, not here: the Container Apps
# revision declares /health as its liveness probe and /ready as its readiness probe
# (cloudlayer/azure.py, deploy). SageMaker would map /ping and /invocations the same way.
# The routes in service/app.py are untouched, which is what keeps this image portable.
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
