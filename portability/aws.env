# Lab 5 Task 4: cloud.env for the second provider. Load it over the Azure one:
#   set -a; . ./portability/aws.env; set +a
CLOUD_PROVIDER=aws
BLOB_URI=s3://itcs355-portability/lab5
AWS_REGION=ap-southeast-1
# The emulator. Remove these three lines and the same adapter talks to AWS with real credentials.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
